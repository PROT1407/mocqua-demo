# Để trống. Điền khóa thật vào biến môi trường của Render, không commit.
GEMINI_API_KEY=
# Mặc định gemini-3.5-flash-lite nếu bỏ trống. gemini-2.5-flash không dùng được với khóa mới.
GEMINI_MODEL=gemini-3.5-flash-lite
# Danh mục công khai của cửa hàng. Mặc định là /api/danh-muc trên shop đang chạy.
MOCQUA_CATALOG_URL=https://mocqua.onrender.com/api/danh-muc
# Gốc link sản phẩm. Mặc định https://mocqua.onrender.com
SHOP_PUBLIC_URL=https://mocqua.onrender.com
PORT=10000

# Cùng bot Telegram với cửa hàng, để báo khách Facebook. Để trống thì không gửi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Facebook Messenger. Để trống thì webhook không xử lý tin.
FB_VERIFY_TOKEN=
FB_APP_SECRET=
FB_PAGE_ACCESS_TOKEN=
