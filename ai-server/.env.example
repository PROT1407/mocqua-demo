# Để trống. Điền khóa thật vào biến môi trường của Render, không commit.
GEMINI_API_KEY=
# Mặc định gemini-3.5-flash-lite nếu bỏ trống. gemini-2.5-flash không dùng được với khóa mới.
GEMINI_MODEL=gemini-3.5-flash-lite
# Danh mục công khai của cửa hàng. Mặc định là /api/danh-muc trên shop đang chạy.
MOCQUA_CATALOG_URL=https://mocqua.onrender.com/api/danh-muc
PORT=10000
