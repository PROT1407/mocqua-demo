# Cổng máy chủ. Mặc định 3000.
PORT=3000

# Mật khẩu trang /admin. Để trống thì không đăng nhập được.
# Đặt một câu dài, chỉ mình chủ shop biết. Không ghi mật khẩu thật vào git.
ADMIN_PASSWORD=

# Khoá ký cookie đăng nhập. Nếu bỏ trống, máy chủ dùng tạm ADMIN_PASSWORD.
ADMIN_SECRET=

# Tài khoản nhận chuyển khoản. Để trống cả ba dòng dưới thì trang đơn
# vẫn hiện số tiền và mã đơn, nhưng chưa có mã QR.
# BANK_BIN là mã NAPAS 6 số của ngân hàng (chủ shop tự tra trên trang ngân hàng).
# Không điền số tài khoản mẫu — chỉ điền số thật khi chạy shop.
BANK_BIN=
BANK_NAME=
ACCOUNT_NO=
ACCOUNT_NAME=

# File SQLite. Bỏ trống thì dùng data/mocqua.sqlite.
# DB_PATH=data/mocqua.sqlite
