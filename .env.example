# Cổng máy chủ. Mặc định 3000.
PORT=3000

# Mật khẩu trang /admin. Để trống thì không đăng nhập được.
# Đặt một câu dài, chỉ mình chủ shop biết. Không ghi mật khẩu thật vào git.
ADMIN_PASSWORD=

# Khoá ký cookie đăng nhập. Nếu bỏ trống, máy chủ dùng tạm ADMIN_PASSWORD.
ADMIN_SECRET=

# Tài khoản nhận chuyển khoản của Mộc Quả (số công khai, khách cần thấy để chuyển tiền).
# Đặt trên máy chủ khi chạy thật. Nếu để trống, server/vietqr.js dùng cùng tài khoản này.
# BANK_BIN 970407 là mã NAPAS của Techcombank.
# ACCOUNT_NAME viết hoa, không dấu, đúng tên in trên VietQR.
BANK_BIN=970407
BANK_NAME=Techcombank
ACCOUNT_NO=19029781376018
ACCOUNT_NAME=NGUYEN NGOC HUY

# File SQLite. Bỏ trống thì dùng data/mocqua.sqlite.
# DB_PATH=data/mocqua.sqlite
